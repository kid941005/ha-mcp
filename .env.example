# ===== Home Assistant 连接 =====
HA_URL=https://ha.hqgg.top:59826
HA_TOKEN=请替换为你的HA长期访问令牌

# ===== MCP 服务 =====
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8090
MCP_PATH=/mcp
MCP_SSE_PATH=/sse

# ===== HA 请求 =====
HA_TIMEOUT=10
HA_VERIFY_SSL=true
HA_TRUST_ENV=false

# ===== 设备/实体注册表（按设备聚合，HA 仅 WebSocket API 提供） =====
HA_WS_ENABLED=true
# 留空则由 HA_URL 自动推导为 ws(s)://<host>/api/websocket
HA_WS_URL=
HA_REGISTRY_TTL=60
# 服务调用后回读确认（三态反馈）
SERVICE_CONFIRM_DELAY=0.6
SERVICE_CONFIRM_RETRIES=1

# ===== 其他 =====
LOG_LEVEL=INFO
DEFAULT_LIST_LIMIT=50
MAX_LIST_LIMIT=500
