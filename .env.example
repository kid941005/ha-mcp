# ===== Home Assistant 连接 =====
HA_URL=https://ha.hqgg.top:59826
HA_TOKEN=请替换为你的HA长期访问令牌

# ===== MCP 服务 =====
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8090
MCP_PATH=/mcp
MCP_SSE_PATH=/sse

# ===== HA 请求 =====
HA_TIMEOUT=10
HA_VERIFY_SSL=true
HA_TRUST_ENV=false

# ===== 其他 =====
LOG_LEVEL=INFO
DEFAULT_LIST_LIMIT=50
MAX_LIST_LIMIT=500
