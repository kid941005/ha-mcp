# ===== 小智 MCP 接入点（工具端 WebSocket）=====
# 从智控台「MCP 接入点」参数中获取工具端地址；不是 /mcp_endpoint/health?key=... 那个地址。
MCP_ENDPOINT=ws://<宿主>:8004/mcp_endpoint/mcp/?token=<TOKEN>

# ===== Home Assistant 连接 =====
HA_URL=https://your-ha.example:8123
HA_TOKEN=请替换为你的HA长期访问令牌

# ===== HA 请求 =====
HA_TIMEOUT=10
HA_VERIFY_SSL=true
HA_TRUST_ENV=false

# ===== 设备/实体注册表（按设备聚合，HA 仅 WebSocket API 提供） =====
HA_WS_ENABLED=true
# 留空则由 HA_URL 自动推导为 ws(s)://<host>/api/websocket
HA_WS_URL=
HA_REGISTRY_TTL=60
# 注册表读取失败后的重试间隔（秒），避免瞬时 WS 故障后长时间不重试
HA_REGISTRY_ERROR_TTL=10
# 服务调用后回读确认（状态+属性四态校验：confirmed/no_change/mismatch/accepted_pending）
SERVICE_CONFIRM_DELAY=0.6
SERVICE_CONFIRM_RETRIES=1
SERVICE_CONFIRM_INTERVAL=0.6
SERVICE_CONFIRM_TIMEOUT=4.0

# ===== 危险设备二次确认（防误操作） =====
# 门锁/安防面板/车库门/门窗类 cover 需二次确认；首次返回 confirmation_required + confirm_token
DANGER_CONFIRM_ENABLED=true
DANGER_CONFIRM_TTL=120
DANGEROUS_DOMAINS=lock,alarm_control_panel
DANGEROUS_COVER_CLASSES=garage,door,gate,window

# ===== 其他 =====
LOG_LEVEL=INFO
DEFAULT_LIST_LIMIT=50
MAX_LIST_LIMIT=500

# ===== 可选 WebUI（默认关闭）=====
# 仅当 WEBUI_ENABLED=true 时才启动管理界面；WebUI 为独立进程/独立容器，不影响 MCP 桥接。
WEBUI_ENABLED=false
# 必填且必须足够随机；未设置时 WebUI 拒绝启动。用于 HTTP Basic 密码或 Bearer Token。
WEBUI_TOKEN=请替换为足够长的随机字符串
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8099
# 宿主机端口绑定地址：127.0.0.1 仅本机；局域网访问填宿主机局域网 IP（如 192.168.50.100）
WEBUI_BIND=127.0.0.1
